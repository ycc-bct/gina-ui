{
  "theme": {
    "$description": "淺色主題（目前使用中）。元件只引用這一層。",
    "bg": {
      "app": {
        "$type": "color",
        "$value": "oklch(95.5% 0.014 260)",
        "$description": "App 外框後方的背景"
      },
      "canvas": {
        "$type": "color",
        "$value": "oklch(98% 0.006 260)",
        "$description": "工作區畫布"
      },
      "surface": {
        "$type": "color",
        "$value": "oklch(99.4% 0.002 260)",
        "$description": "側欄、彈出層、抽屜、AI 泡泡"
      },
      "raised": {
        "$type": "color",
        "$value": "{color.gray.0}",
        "$description": "輸入框、卡片"
      },
      "field": {
        "$type": "color",
        "$value": "oklch(97% 0.008 260)",
        "$description": "搜尋欄、協作專員按鈕"
      },
      "hover": {
        "$type": "color",
        "$value": "{theme.accent.blue.bg}",
        "$description": "列表、按鈕 hover"
      },
      "selected": {
        "$type": "color",
        "$value": "{theme.accent.blue.bg}",
        "$description": "選取、按下、使用者泡泡"
      },
      "overlay": {
        "$type": "color",
        "$value": "#25272822",
        "$description": "抽屜後方遮罩"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.gray.900}",
        "$description": "標題、內文"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.gray.700}",
        "$description": "次要文字、側欄項目"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.gray.600}",
        "$description": "說明、時間、計數"
      },
      "placeholder": {
        "$type": "color",
        "$value": "{color.gray.550}",
        "$description": "placeholder"
      },
      "disabled": {
        "$type": "color",
        "$value": "{color.gray.550}",
        "$description": "停用"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.gray.0}",
        "$description": "深色按鈕上的文字"
      }
    },
    "icon": {
      "default": {
        "$type": "color",
        "$value": "{color.gray.700}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.gray.600}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.gray.200}",
        "$description": "卡片、側欄、分隔線"
      },
      "default": {
        "$type": "color",
        "$value": "{color.gray.300}",
        "$description": "按鈕、欄位"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.gray.400}",
        "$description": "hover 框線"
      },
      "focus": {
        "$type": "color",
        "$value": "{theme.accent.blue.fg}",
        "$description": "輸入框 focus"
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{theme.accent.blue.fg}",
        "$description": "鍵盤 focus outline，2px，offset 3px"
      }
    },
    "action": {
      "primary": {
        "bg": {
          "$type": "color",
          "$value": "#aad7f3",
          "$description": "確認寄出、送出（可送出）"
        },
        "bgHover": {
          "$type": "color",
          "$value": "#93cbee"
        },
        "fg": {
          "$type": "color",
          "$value": "#174c6e"
        }
      },
      "secondary": {
        "bg": {
          "$type": "color",
          "$value": "{theme.bg.surface}",
          "$description": "發起新對話"
        },
        "bgHover": {
          "$type": "color",
          "$value": "{theme.accent.blue.bg}"
        },
        "border": {
          "$type": "color",
          "$value": "{theme.border.default}"
        },
        "fg": {
          "$type": "color",
          "$value": "{theme.text.secondary}"
        }
      },
      "disabled": {
        "bg": {
          "$type": "color",
          "$value": "{color.gray.100}",
          "$description": "送出（未輸入）"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.gray.550}"
        }
      }
    },
    "status": {
      "success": {
        "fg": {
          "$type": "color",
          "$value": "{color.green.600}",
          "$description": "綠色文字（D2）"
        },
        "icon": {
          "$type": "color",
          "$value": "{color.green.500}",
          "$description": "連線圓點、完成勾勾（D2）"
        },
        "bg": {
          "$type": "color",
          "$value": "{color.green.50}"
        }
      },
      "danger": {
        "fg": {
          "$type": "color",
          "$value": "{color.red.500}",
          "$description": "登出、中斷連線、錯誤"
        },
        "bg": {
          "$type": "color",
          "$value": "{color.red.50}"
        }
      },
      "warning": {
        "fg": {
          "$type": "color",
          "$value": "{color.amber.500}"
        },
        "bg": {
          "$type": "color",
          "$value": "{color.amber.50}"
        }
      },
      "info": {
        "fg": {
          "$type": "color",
          "$value": "{color.blue.500}"
        },
        "bg": {
          "$type": "color",
          "$value": "{color.blue.50}"
        }
      }
    },
    "shadow": {
      "xs": {
        "$type": "shadow",
        "$value": "{shadow.xs}"
      },
      "sm": {
        "$type": "shadow",
        "$value": "{shadow.sm}"
      },
      "md": {
        "$type": "shadow",
        "$value": "{shadow.md}"
      },
      "lg": {
        "$type": "shadow",
        "$value": "{shadow.lg}"
      },
      "frame": {
        "$type": "shadow",
        "$value": "{shadow.frame}"
      },
      "focus": {
        "$type": "shadow",
        "$value": "0 0 0 3px #254fc414",
        "$description": "輸入框 focus 時的淡外圈"
      }
    },
    "accent": {
      "blue": {
        "bg": {
          "$type": "color",
          "$value": "#e9f5fd"
        },
        "border": {
          "$type": "color",
          "$value": "#aad7f3"
        },
        "fg": {
          "$type": "color",
          "$value": "#176394"
        }
      },
      "pink": {
        "bg": {
          "$type": "color",
          "$value": "#fff0f6"
        },
        "border": {
          "$type": "color",
          "$value": "#f2cbdc"
        },
        "fg": {
          "$type": "color",
          "$value": "#a52c65"
        }
      },
      "amber": {
        "bg": {
          "$type": "color",
          "$value": "#fff6df"
        },
        "border": {
          "$type": "color",
          "$value": "#ecd79f"
        },
        "fg": {
          "$type": "color",
          "$value": "#865b08"
        }
      },
      "green": {
        "bg": {
          "$type": "color",
          "$value": "#eaf6ef"
        },
        "border": {
          "$type": "color",
          "$value": "#bbddc9"
        },
        "fg": {
          "$type": "color",
          "$value": "#236644"
        }
      }
    },
    "glass": {
      "surface": {
        "$type": "color",
        "$value": "oklch(99.5% 0.004 260 / 0.78)"
      },
      "border": {
        "$type": "color",
        "$value": "oklch(100% 0 0 / 0.88)"
      },
      "blue": {
        "$type": "color",
        "$value": "oklch(83% 0.065 260 / 0.24)"
      },
      "pink": {
        "$type": "color",
        "$value": "oklch(89% 0.055 345 / 0.20)"
      },
      "amber": {
        "$type": "color",
        "$value": "oklch(92% 0.055 85 / 0.16)"
      }
    }
  }
}
