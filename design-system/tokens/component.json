        "$type": "dimension",
        "$value": "20px",
        "$description": "一般高度；Agent 首頁名字旁為 24px"
      },
      "heightLarge": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Agent 首頁名字旁"
      },
      "paddingX": {
        "$type": "dimension",
        "$value": "6px",
