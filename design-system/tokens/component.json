{
  "$description": "元件層 token：只放元件專屬、會被多處共用或 RD 需要明確知道的值。顏色一律引用 theme 層。",
  "component": {
    "button": {
      "height": {
        "$type": "dimension",
        "$value": "{size.control.md}"
      },
      "heightLg": {
        "$type": "dimension",
        "$value": "{size.control.lg}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      },
      "paddingX": {
        "$type": "dimension",
        "$value": "{space.3}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.2}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.size.13}"
      },
      "fontSizeLg": {
        "$type": "dimension",
        "$value": "{font.size.14}"
      }
    },
    "iconButton": {
      "size": {
        "$type": "dimension",
        "$value": "{size.control.md}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      }
    },
    "navItem": {
      "height": {
        "$type": "dimension",
        "$value": "{size.control.md}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      },
      "paddingX": {
        "$type": "dimension",
        "$value": "{space.2h}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{space.2h}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.size.14}"
      }
    },
    "chip": {
      "height": {
        "$type": "dimension",
        "$value": "{size.control.md}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      },
      "paddingX": {
        "$type": "dimension",
        "$value": "{space.4}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.size.13}"
      }
    },
    "field": {
      "height": {
        "$type": "dimension",
        "$value": "{size.control.md}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.md}"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.size.14}"
      }
    },
    "composer": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.2xl}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.3h}"
      },
      "minHeight": {
        "$type": "dimension",
        "$value": "72px"
      },
      "textMaxHeight": {
        "$type": "dimension",
        "$value": "144px",
        "$description": "約 6 行，之後捲動"
      }
    },
    "bubble": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.xl}"
      },
      "tailRadius": {
        "$type": "dimension",
        "$value": "{radius.xs}"
      },
      "paddingAi": {
        "$type": "dimension",
        "$value": "18px 20px"
      },
      "paddingUser": {
        "$type": "dimension",
        "$value": "12px 18px"
      },
      "fontSize": {
        "$type": "dimension",
        "$value": "{font.size.14}"
      }
    },
    "menu": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.lg}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{space.1h}"
      },
      "itemHeight": {
        "$type": "dimension",
        "$value": "{size.control.md}"
      }
    },
    "popover": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.xl}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "18px"
      }
    },
    "drawer": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.2xl}"
      }
    },
    "ginaAvatar": {
      "$description": "首頁 Gina 頭像（Thought / Buddy / Host）與使用者選單的 Gina Avatar 選擇器。三款「看得到的大小」一致，外框依各自留白放大。",
      "visible": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "首頁三款頭像看得到的大小"
      },
      "gap": {
        "$type": "dimension",
        "$value": "22px",
        "$description": "頭像與兩行招呼語的視覺間距"
      },
      "thoughtBox": {
        "$type": "dimension",
        "$value": "80px",
        "$description": "Thought 外框（圖形約佔 80%），上下負邊距 -8px"
      },
      "buddyBox": {
        "$type": "dimension",
        "$value": "84px",
        "$description": "Buddy 外框（球半徑 46 / viewBox 120），上下負邊距 -10px"
      },
      "hostBox": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "Host 插畫方塊（填滿）"
      },
      "hostRadius": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Host 插畫方塊圓角"
      },
      "pickerTile": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "選擇器卡片方塊"
      },
      "pickerRadius": {
        "$type": "dimension",
        "$value": "10px",
        "$description": "選擇器卡片圓角"
      },
      "pickerThumb": {
        "$type": "dimension",
        "$value": "40px",
        "$description": "選擇器縮圖看得到的大小"
      }
    },
    "greeting": {
      "$description": "首頁兩行招呼語（三款頭像共用）",
      "fontSize": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "字級"
      },
      "fontWeight": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "字重"
      },
      "lineHeight": {
        "$type": "number",
        "$value": 1.3,
        "$description": "行高"
      }
    }
  }
}
