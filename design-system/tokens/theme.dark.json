{
  "theme": {
    "$description": "深色主題草案：保留結構與數值，畫面尚未驗證。用 <html data-theme=\"dark\"> 啟用。",
    "bg": {
      "app": {
        "$type": "color",
        "$value": "{color.dark.0}",
        "$description": "App 外框後方的背景"
      },
      "canvas": {
        "$type": "color",
        "$value": "{color.dark.50}",
        "$description": "工作區畫布"
      },
      "surface": {
        "$type": "color",
        "$value": "{color.dark.100}",
        "$description": "側欄、彈出層、抽屜、AI 泡泡"
      },
      "raised": {
        "$type": "color",
        "$value": "{color.dark.150}",
        "$description": "輸入框、卡片"
      },
      "field": {
        "$type": "color",
        "$value": "{color.dark.150}",
        "$description": "搜尋欄、協作專員按鈕"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.dark.200}",
        "$description": "列表、按鈕 hover"
      },
      "selected": {
        "$type": "color",
        "$value": "{color.dark.300}",
        "$description": "選取、按下、使用者泡泡"
      },
      "overlay": {
        "$type": "color",
        "$value": "#00000080",
        "$description": "抽屜後方遮罩"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.dark.900}",
        "$description": "標題、內文"
      },
      "secondary": {
        "$type": "color",
        "$value": "{color.dark.700}",
        "$description": "次要文字、側欄項目"
      },
      "tertiary": {
        "$type": "color",
        "$value": "{color.dark.600}",
        "$description": "說明、時間、計數"
      },
      "placeholder": {
        "$type": "color",
        "$value": "#7a7d7f",
        "$description": "placeholder"
      },
      "disabled": {
        "$type": "color",
        "$value": "#7a7d7f",
        "$description": "停用"
      },
      "inverse": {
        "$type": "color",
        "$value": "{color.dark.50}",
        "$description": "深色按鈕上的文字"
      }
    },
    "icon": {
      "default": {
        "$type": "color",
        "$value": "{color.dark.700}"
      },
      "muted": {
        "$type": "color",
        "$value": "{color.dark.600}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{color.dark.200}",
        "$description": "卡片、側欄、分隔線"
      },
      "default": {
        "$type": "color",
        "$value": "{color.dark.300}",
        "$description": "按鈕、欄位"
      },
      "strong": {
        "$type": "color",
        "$value": "{color.dark.400}",
        "$description": "hover 框線"
      },
      "focus": {
        "$type": "color",
        "$value": "{color.dark.500}",
        "$description": "輸入框 focus"
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "{color.dark.700}",
        "$description": "鍵盤 focus outline，2px，offset 3px"
      }
    },
    "action": {
      "primary": {
        "bg": {
          "$type": "color",
          "$value": "{color.dark.900}",
          "$description": "確認寄出、送出（可送出）"
        },
        "bgHover": {
          "$type": "color",
          "$value": "#ffffff"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.dark.50}"
        }
      },
      "secondary": {
        "bg": {
          "$type": "color",
          "$value": "{color.dark.200}",
          "$description": "發起新對話"
        },
        "bgHover": {
          "$type": "color",
          "$value": "{color.dark.300}"
        },
        "border": {
          "$type": "color",
          "$value": "{color.dark.300}"
        },
        "fg": {
          "$type": "color",
          "$value": "{color.dark.900}"
        }
      },
      "disabled": {
        "bg": {
          "$type": "color",
          "$value": "{color.dark.200}",
          "$description": "送出（未輸入）"
        },
        "fg": {
          "$type": "color",
          "$value": "#7a7d7f"
        }
      }
    },
    "status": {
      "success": {
        "fg": {
          "$type": "color",
          "$value": "#6fae92",
          "$description": "已連線"
        },
        "icon": {
          "$type": "color",
          "$value": "#6fae92",
          "$description": "連線圓點、完成勾勾（D2）"
        },
        "bg": {
          "$type": "color",
          "$value": "#1d2a24"
        }
      },
      "danger": {
        "fg": {
          "$type": "color",
          "$value": "#e07a68",
          "$description": "登出、中斷連線、錯誤"
        },
        "bg": {
          "$type": "color",
          "$value": "#2e1f1c"
        }
      },
      "warning": {
        "fg": {
          "$type": "color",
          "$value": "#d7a356"
        },
        "bg": {
          "$type": "color",
          "$value": "#2c2416"
        }
      },
      "info": {
        "fg": {
          "$type": "color",
          "$value": "#82a9d4"
        },
        "bg": {
          "$type": "color",
          "$value": "#1b2430"
        }
      }
    },
    "shadow": {
      "xs": {
        "$type": "shadow",
        "$value": "0 1px 2px #00000040"
      },
      "sm": {
        "$type": "shadow",
        "$value": "0 3px 12px #00000040"
      },
      "md": {
        "$type": "shadow",
        "$value": "0 8px 28px #00000066"
      },
      "lg": {
        "$type": "shadow",
        "$value": "0 12px 40px #00000073, 0 2px 6px #00000040"
      },
      "frame": {
        "$type": "shadow",
        "$value": "0 16px 48px #00000059"
      },
      "focus": {
        "$type": "shadow",
        "$value": "0 0 0 3px #ffffff0d",
        "$description": "輸入框 focus 時的淡外圈"
      }
    }
  }
}